[mysqld_safe]
socket		= /var/run/mysqld/mysqld.sock
nice		= 0

[mysqld]
#
# * Basic Settings
#
user		= mysql
#pid-file = /home/hong.wu/local/mysqld.pid
socket		= /var/run/mysqld/mysqld.sock
port		= 3306
#basedir = /home/hong.wu/local/
datadir		= /var/lib/mysql
tmpdir		= /tmp
# secure_file_priv =
# skip-external-locking
# skip-grant-tables
# performance_schema
#show_compatibility_56 = ON
#
# Instead of skip-networking the default is now to listen only on
# localhost which is more compatible and is not less secure.
bind-address		= 127.0.0.1
sql_mode		= NO_ENGINE_SUBSTITUTION
log_error		= /var/log/mysql/error.log
log_error_verbosity		= 3
slow_query_log_file		= /var/log/mysql/base/mysql-slow.log
log_bin		= /var/lib/mysql/mysql-bin.log
#binlog_do_db		= include_database_name
#binlog_ignore_db		= include_database_name
myisam-recover-options		= BACKUP
max_connections		= 99000
binlog-format		= ROW
server_id		= 406590050
innodb_log_checksums		= OFF
expire_logs_days		= 57
innodb_force_load_corrupted		= OFF
autocommit		= OFF
automatic_sp_privileges		= ON
back_log		= 54463
binlog_cache_size		= 115626129
binlog_direct_non_transactional_updates		= OFF
binlog_error_action		= ABORT_SERVER
binlog_format		= MIXED
binlog_group_commit_sync_delay		= 914591
binlog_group_commit_sync_no_delay_count		= 606
binlog_order_commits		= ON
binlog_row_image		= noblob
binlog_rows_query_log_events		= ON
binlog_stmt_cache_size		= 3812469453
bulk_insert_buffer_size		= 8004012
check_proxy_users		= OFF
completion_type		= NO_CHAIN
concurrent_insert		= ALWAYS
connect_timeout		= 19623364
default_week_format		= 6
delay_key_write		= ALL
div_precision_increment		= 1
end_markers_in_json		= OFF
eq_range_index_dive_limit		= 4187018239
