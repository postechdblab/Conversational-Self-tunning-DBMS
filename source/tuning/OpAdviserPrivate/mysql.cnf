[mysqld_safe]
socket		= /var/run/mysqld/mysqld.sock
nice		= 0

[mysqld]
#
# * Basic Settings
#
user		= mysql
#pid-file = /home/hong.wu/local/mysqld.pid
socket		= /var/run/mysqld/mysqld.sock
port		= 3308
#basedir = /home/hong.wu/local/
datadir		= /var/lib/mysql
tmpdir		= /tmp
# secure_file_priv =
# skip-external-locking
# skip-grant-tables
# performance_schema
#show_compatibility_56 = ON
#
# Instead of skip-networking the default is now to listen only on
# localhost which is more compatible and is not less secure.
bind-address		= 127.0.0.1
sql_mode		= NO_ENGINE_SUBSTITUTION
log_error		= /var/log/mysql/error.log
log_error_verbosity		= 3
slow_query_log_file		= /var/log/mysql/base/mysql-slow.log
log_bin		= /var/lib/mysql/mysql-bin.log
#binlog_do_db		= include_database_name
#binlog_ignore_db		= include_database_name
myisam-recover-options		= BACKUP
max_connections		= 8817
binlog-format		= ROW
server_id		= 406590050
innodb_log_checksums		= OFF
expire_logs_days		= 32
innodb_force_load_corrupted		= OFF
autocommit		= OFF
automatic_sp_privileges		= OFF
back_log		= 36278
binlog_cache_size		= 1555516596
binlog_direct_non_transactional_updates		= ON
binlog_error_action		= IGNORE_ERROR
binlog_format		= ROW
binlog_group_commit_sync_delay		= 396887
binlog_group_commit_sync_no_delay_count		= 0
binlog_order_commits		= OFF
binlog_row_image		= minimal
binlog_rows_query_log_events		= ON
binlog_stmt_cache_size		= 509575981
bulk_insert_buffer_size		= 16644381
check_proxy_users		= ON
completion_type		= NO_CHAIN
concurrent_insert		= AUTO
connect_timeout		= 19940306
default_week_format		= 7
delay_key_write		= OFF
div_precision_increment		= 10
end_markers_in_json		= ON
